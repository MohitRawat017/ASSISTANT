# Tsuzi — Environment Variables Example
#
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file — it is gitignored.
# Rotate any key that has been pasted into chat or logs.

# --- Assistant runtime (Ollama, local) ---
OLLAMA_MODEL=qwen3.5:4b
# Ollama server host (default shown); only needed for a remote server
# OLLAMA_BASE_URL=http://localhost:11434
# Call timeout/retry budget. Model-call retries never replay completed tools.
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_MAX_RETRIES=0

# --- Optional cloud providers (leave unset to stay fully local) ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Vision (Phase 5) ---
# VISION_PROVIDER: auto = NVIDIA when NVIDIA_API_KEY is set, else local Ollama
VISION_PROVIDER=auto
NVIDIA_API_KEY=
# Leave VISION_MODEL unset for provider-aware defaults, or override it:
# VISION_MODEL=qwen/qwen3.5-122b-a10b
VISION_TEMPERATURE=0.6
VISION_TOP_P=0.95
VISION_MAX_COMPLETION_TOKENS=16384

# Local Ollama fallback settings
VISION_MODEL_HOST=http://localhost:11434
# 0 = CPU-only inference; >0 = GPU offload layers
VISION_NUM_GPU=99
# Optional provider call timeout and safe-read retry budget.
# VISION_TIMEOUT_SECONDS=120
# VISION_MAX_RETRIES=0

# --- Google API request boundaries ---
# GOOGLE_TIMEOUT_SECONDS=30
# GOOGLE_MAX_RETRIES=2

# --- Durable conversation checkpoints (R8) ---
# Local SQLite path; the default is data/checkpoints.db.
# CHECKPOINT_DB_PATH=data/checkpoints.db
# CHECKPOINT_RETENTION=keep_latest

# --- Long-term memory safety (R6) ---
# MEMORY_CONTEXT_MAX_CHARS=6000
# MEMORY_ITEM_MAX_CHARS=500
# MEMORY_MAX_ITEMS_PER_CATEGORY=10
# MEMORY_BUSY_TIMEOUT_MS=10000

# --- Debugging ---
# true opts into the concise console tool-call trace; JSONL query logs remain on
DEBUG_MODE=false
TRACE_RETENTION_DAYS=14
TRACE_MAX_BYTES=5000000
TRACE_BACKUP_COUNT=3
SCREENSHOT_MAX_FILES=50

# --- Telegram interface ---
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id allowed to control the bot (0 = allowlist disabled)
TELEGRAM_ALLOWED_USER_ID=

# --- Gmail (app password, NOT your login password) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Destination for reminder emails; defaults to GMAIL_ADDRESS
REMINDER_EMAIL=
